ENVIRONMENT=loc

APP_NAME=Actora
SECRET_KEY=change-me-in-real-env
ROOT_PATH=

ALLOWED_DOMAINS=http://localhost:3000

# Database (PostgreSQL)
# sync(psycopg2) URL — 런타임에서 async(asyncpg)로 자동 변환됨
DATABASE_URL=postgresql+psycopg2://actora_user:CHANGE_ME@3.35.101.121:5432/actora

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_SESSION_TIMEOUT=3600

LOGGING_LEVEL=INFO
OPENAI_API_KEY=sk-...

# ── 파일 저장소 (오브젝트 스토리지) ─────────────────────────
# 개발 PC 와 운영 서버가 **같은 버킷**을 쓴다. 파일 동기화가 필요 없다.
# S3_BUCKET 을 비우면 로컬 디스크(UPLOAD_DIR)로 폴백한다 — 그 경우 두 환경의
# 파일이 분리되어 한쪽에서 올린 영상이 반대쪽에서 재생되지 않는다.
S3_BUCKET=bucket-e3dami
S3_REGION=ap-northeast-2
# 개발 PC 는 AWS 밖이라 액세스 키가 필요하다.
# Lightsail 콘솔 → 버킷 → Permissions → Access keys → Create access key
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
