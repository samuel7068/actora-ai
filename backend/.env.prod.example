ENVIRONMENT=prod

APP_NAME=Actora
SECRET_KEY=CHANGE_ME_IN_PROD
ROOT_PATH=

# 프론트엔드 origin (도커 내부 통신은 동일 origin이지만, 직접 CORS 호출 시 필요)
ALLOWED_DOMAINS=http://3.35.101.121,http://localhost

# PostgreSQL — 호스트 native 에 host.docker.internal 로 접근
# sync(psycopg2) URL — 런타임에서 async(asyncpg)로 자동 변환됨
DATABASE_URL=postgresql+psycopg2://actora_user:CHANGE_ME_PROD_PASSWORD@host.docker.internal:5432/actora

# Qdrant (docker network 내부)
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=

# Redis (현재 미사용. 사용 시 service 추가)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_SESSION_TIMEOUT=3600

LOGGING_LEVEL=INFO
OPENAI_API_KEY=sk-...

# ── 파일 저장소 (오브젝트 스토리지) ─────────────────────────
# 개발 PC 와 운영 서버가 **같은 버킷**을 쓴다. 파일 동기화가 필요 없다.
# S3_BUCKET 을 비우면 로컬 디스크(UPLOAD_DIR)로 폴백한다 — 그 경우 두 환경의
# 파일이 분리되어 한쪽에서 올린 영상이 반대쪽에서 재생되지 않는다.
S3_BUCKET=bucket-e3dami
S3_REGION=ap-northeast-2
# 운영 서버는 Lightsail 콘솔에서 버킷에 인스턴스를 attach 했으므로
# 액세스 키를 두지 않는다 (boto3 가 인스턴스 자격증명을 자동으로 찾는다).
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
